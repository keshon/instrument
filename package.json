{
  "name": "instrument-ui",
  "version": "0.1.0",
  "description": "CSS-кит для интерфейсов, показывающих работу машины: очереди задач, прогоны, логи, инспекторы, состояния",
  "license": "MIT",
  "author": "Innokentiy Sokolov",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "main": "./src/kit.css",
  "style": "./src/kit.css",
  "exports": {
    ".": "./src/kit.css",
    "./kit.css": "./src/kit.css",
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "check": "node tools/contrast.mjs && node tools/docs-check.mjs",
    "check:contrast": "node tools/contrast.mjs",
    "check:docs": "node tools/docs-check.mjs",
    "classes": "node tools/classes.mjs",
    "start": "python -m http.server 8321"
  },
  "keywords": [
    "css",
    "ui-kit",
    "design-system",
    "design-tokens",
    "dashboard",
    "admin-ui",
    "agent-ui",
    "no-build",
    "oklch",
    "cascade-layers"
  ],
  "engines": {
    "node": ">=20"
  }
}
