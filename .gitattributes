# Поставка обязана быть побайтово одинаковой на всех системах: её отдают
# потребителю как есть, и перенос строки, зависящий от того, кто сделал
# checkout, — это разные файлы под одной версией.
dist/** text eol=lf

# Исходники кита тоже: их читает сверка dist -check.
src/**  text eol=lf
VERSION text eol=lf
# Каталог, который копируется в корень сайта как есть. Возврат каретки в
# CNAME — это возврат каретки в имени домена: сайт не открывается, а в
# диффе не видно ничего.
site/public/** text eol=lf
